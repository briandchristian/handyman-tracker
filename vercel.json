{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "handyman-tracker.vercel.app"
        }
      ],
      "destination": "https://www.christian-security-services.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/catchall?path=$1"
    },
    {
      "source": "/bid",
      "destination": "/bid/index.html"
    },
    {
      "source": "/login",
      "destination": "/login/index.html"
    },
    {
      "source": "/service-area",
      "destination": "/service-area/index.html"
    },
    {
      "source": "/services/burglar-alarms",
      "destination": "/services/burglar-alarms/index.html"
    },
    {
      "source": "/services/fire-alarms",
      "destination": "/services/fire-alarms/index.html"
    },
    {
      "source": "/services/cctv",
      "destination": "/services/cctv/index.html"
    },
    {
      "source": "/services/access-control",
      "destination": "/services/access-control/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/customer",
      "destination": "/index.html"
    },
    {
      "source": "/customers",
      "destination": "/index.html"
    },
    {
      "source": "/customers/:customerId",
      "destination": "/index.html"
    },
    {
      "source": "/installation-history",
      "destination": "/index.html"
    },
    {
      "source": "/projects/:customerId/:projectId",
      "destination": "/index.html"
    },
    {
      "source": "/admin/users",
      "destination": "/index.html"
    },
    {
      "source": "/admin/bid-alerts",
      "destination": "/index.html"
    },
    {
      "source": "/suppliers",
      "destination": "/index.html"
    },
    {
      "source": "/purchase-orders",
      "destination": "/index.html"
    },
    {
      "source": "/inventory",
      "destination": "/index.html"
    },
    {
      "source": "/accounting",
      "destination": "/index.html"
    },
    {
      "source": "/subcontractor",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/catchall.js": {
      "memory": 1024
    }
  }
}
